// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Flutter: Launch App",
    "adapter": "Dart",
    "request": "launch",
    "program": "lib/main.dart",
    "type": "flutter",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "flutterMode": "run",
    "console": "debugConsole",
  },
  {
    "label": "Flutter: Launch App (Chrome/Web)",
    "adapter": "dart",
    "request": "launch",
    "program": "lib/main.dart",
    "cwd": "$ZED_WORKTREE_ROOT",
    "toolArgs": ["-d", "chrome"],
  },
  {
    "label": "Dart: Run CLI / Script",
    "adapter": "dart",
    "request": "launch",
    "program": "bin/main.dart",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Flutter: Attach to Running App",
    "adapter": "dart",
    "request": "attach",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
]
